{
  "uid": "ha-agent-v1",
  "title": "hassaleh-agent-per-id",
  "templating": {
    "list": [
      {"name": "env", "type": "custom", "query": "dev,staging,prod"},
      {"name": "agent_id", "type": "custom", "query": "*"}
    ]
  },
  "panels": [
    {"title": "Heartbeats Received", "type": "timeseries", "targets": [{"expr": "sum(rate(hassaleh_heartbeat_received_total{agent_id=~\"$agent_id\"}[5m])) by (agent_id)"}]},
    {"title": "Heartbeats Missed", "type": "timeseries", "targets": [{"expr": "sum(rate(hassaleh_heartbeat_missed_total{agent_id=~\"$agent_id\"}[5m])) by (agent_id)"}]},
    {"title": "Heartbeat Interval p99", "type": "timeseries", "targets": [{"expr": "histogram_quantile(0.99, sum(rate(hassaleh_heartbeat_interval_seconds_bucket{agent_id=~\"$agent_id\"}[5m])) by (le))"}]},
    {"title": "Tool Invocations", "type": "timeseries", "targets": [{"expr": "sum(rate(hassaleh_tool_invocation_total{agent_id=~\"$agent_id\"}[5m])) by (command, result)"}]},
    {"title": "Tool Invocation Duration p99", "type": "timeseries", "targets": [{"expr": "histogram_quantile(0.99, sum(rate(hassaleh_tool_invocation_duration_seconds_bucket[5m])) by (le, command))"}]}
  ]
}