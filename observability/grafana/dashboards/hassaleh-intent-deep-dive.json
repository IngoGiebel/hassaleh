{
  "uid": "ha-intent-v1",
  "title": "hassaleh-intent-deep-dive",
  "templating": {
    "list": [
      {"name": "env", "type": "custom", "query": "dev,staging,prod"},
      {"name": "agent_id", "type": "custom", "query": "*"}
    ]
  },
  "panels": [
    {"title": "Intent Submissions by Agent", "type": "timeseries", "targets": [{"expr": "sum(rate(hassaleh_intent_submitted_total{agent_id=~\"$agent_id\"}[5m])) by (result)"}]},
    {"title": "Intent Duration p99", "type": "timeseries", "targets": [{"expr": "histogram_quantile(0.99, sum(rate(hassaleh_intent_duration_seconds_bucket[5m])) by (le, stage))"}]},
    {"title": "Active Intents by State", "type": "stat", "targets": [{"expr": "hassaleh_active_intents"}]}
  ]
}